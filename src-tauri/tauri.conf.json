{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-zen",
  "version": "0.5.1",
  "identifier": "com.gitzen.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Zen",
        "width": 1200,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/dla652009/git-zen/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExOEVDMzRFOTE5NzE0OTkKUldTWkZKZVJUc09PRWVMQm43TFNHL2ltRnlJSWFFYzB1Q1BuY3ZCNTkzNXYxZGttZTZBVTZ4cHoK"
    }
  }
}
