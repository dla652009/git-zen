{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-zen",
  "version": "0.1.0",
  "identifier": "com.gitzen.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "git-zen",
        "width": 1200,
        "height": 760,
        "minWidth": 860,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
