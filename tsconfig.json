{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],
  "exclude": [
    "src/graph.test.ts",
    "src/lib/overlays.test.ts",
    "src/lib/patch.test.ts",
    "src/lib/safeJson.test.ts",
    "src/workflow.test.ts"
  ]
}
